{
  "name": "textopt-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bench": "pnpm build && pnpm --filter textopt-bench bench",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:packages": "pnpm -r --filter \"./packages/*\" exec publint --strict && pnpm -r --filter \"./packages/*\" exec attw --pack . --profile node16",
    "release": "pnpm build && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build && pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "3.0.0",
    "@types/node": "^24.10.0",
    "prettier": "^3.9.6",
    "publint": "0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
