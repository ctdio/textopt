{
  "name": "@textopt/braintrust",
  "version": "0.0.0",
  "private": true,
  "description": "Braintrust scorers and experiment logging for textopt",
  "keywords": [
    "prompt-optimization",
    "gepa",
    "braintrust",
    "autoevals",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ctdio/textopt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctdio/textopt.git",
    "directory": "packages/braintrust"
  },
  "bugs": {
    "url": "https://github.com/ctdio/textopt/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "textopt": "workspace:*"
  },
  "devDependencies": {
    "autoevals": "^0.3.0"
  }
}
