{
  "name": "@textopt/ai-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Vercel AI SDK adapter for textopt",
  "keywords": [
    "prompt-optimization",
    "gepa",
    "ai-sdk",
    "vercel-ai",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ctdio/textopt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctdio/textopt.git",
    "directory": "packages/ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/ctdio/textopt/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "textopt": "workspace:*"
  },
  "devDependencies": {
    "ai": "^7.0.66"
  }
}
