{
  "name": "@textopt/ai-sdk",
  "version": "0.0.0",
  "description": "Vercel AI SDK adapter for textopt",
  "type": "module",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "textopt": "workspace:*"
  },
  "devDependencies": {
    "ai": "^7.0.66"
  }
}
